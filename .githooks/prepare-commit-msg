#!/usr/bin/env bash
# Strip AI/tooling trailers that some editors append to commit messages.
set -euo pipefail

msg_file="${1:?}"

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

awk '
  {
    lower = tolower($0)
    # Cursor/agents commonly inject Co-Authored-By; drop all such trailers.
    if (lower ~ /^[[:space:]]*co-authored-by:[[:space:]]*/) next
    if (lower ~ /^[[:space:]]*generated-by:[[:space:]]*/) next
    if (lower ~ /^[[:space:]]*made-with:[[:space:]]*/) next
    if (lower ~ /^[[:space:]]*assisted-by:[[:space:]]*/) next
    if ($0 ~ /^[[:space:]]*🤖/) next
    if (lower ~ /^[[:space:]]*generated with[[:space:]]+/) next
    if (lower ~ /^[[:space:]]*signed-off-by:[[:space:]]*(cursor|claude|copilot|chatgpt|openai|anthropic|gemini)/) next
    print
  }
' "$msg_file" > "$tmp"

awk '
  { lines[NR] = $0 }
  END {
    end = NR
    while (end > 0 && lines[end] ~ /^[[:space:]]*$/) end--
    for (i = 1; i <= end; i++) print lines[i]
  }
' "$tmp" > "$msg_file"
