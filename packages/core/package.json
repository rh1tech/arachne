{
	"name": "@arachnejs/core",
	"version": "0.3.0",
	"description": "Arachne kernel: DI container, modules, events, logger",
	"license": "MIT OR Apache-2.0",
	"author": "Mikhail Matveev (https://rh1.tech)",
	"homepage": "https://arachne.rh1.tech/docs/packages/core",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rh1tech/arachne.git",
		"directory": "packages/core"
	},
	"bugs": {
		"url": "https://github.com/rh1tech/arachne/issues"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./mcp": {
			"types": "./src/mcp.ts",
			"import": "./src/mcp.ts",
			"default": "./src/mcp.ts"
		}
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/fixtures",
		"!src/test-utils",
		"README.md",
		"LICENSE-APACHE",
		"LICENSE-MIT"
	],
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "bun run typecheck"
	},
	"devDependencies": {
		"typescript": "^5.9.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@arachnejs/mcp": "workspace:*",
		"zod": "3.25.76"
	}
}
