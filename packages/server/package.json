{
	"name": "@arachne/server",
	"version": "0.0.1",
	"description": "HTTP server for Arachne: typed validated routes, uploads, OpenAPI, middleware",
	"license": "MIT OR Apache-2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./mcp": {
			"types": "./src/mcp.ts",
			"import": "./src/mcp.ts",
			"default": "./src/mcp.ts"
		},
		"./client": {
			"types": "./src/client.ts",
			"import": "./src/client.ts",
			"default": "./src/client.ts"
		},
		"./cbor": {
			"types": "./src/cbor.ts",
			"import": "./src/cbor.ts",
			"default": "./src/cbor.ts"
		}
	},
	"files": [
		"src",
		"README.md"
	],
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "bun run typecheck"
	},
	"dependencies": {
		"@arachne/mcp": "workspace:*",
		"@arachne/router": "workspace:*",
		"cbor-x": "^1.6.6",
		"zod": "3.25.76",
		"@arachne/schema": "workspace:*"
	},
	"devDependencies": {
		"typescript": "^5.9.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
