{
	"name": "@arachnejs/server",
	"version": "0.4.0",
	"description": "HTTP server for Arachne: typed validated routes, uploads, OpenAPI, middleware",
	"license": "MIT OR Apache-2.0",
	"author": "Mikhail Matveev (https://rh1.tech)",
	"homepage": "https://arachne.rh1.tech/docs/packages/server",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rh1tech/arachne.git",
		"directory": "packages/server"
	},
	"bugs": {
		"url": "https://github.com/rh1tech/arachne/issues"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./mcp": {
			"types": "./src/mcp.ts",
			"import": "./src/mcp.ts",
			"default": "./src/mcp.ts"
		},
		"./client": {
			"types": "./src/client.ts",
			"import": "./src/client.ts",
			"default": "./src/client.ts"
		},
		"./cbor": {
			"types": "./src/cbor.ts",
			"import": "./src/cbor.ts",
			"default": "./src/cbor.ts"
		}
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/fixtures",
		"!src/test-utils",
		"README.md",
		"LICENSE-APACHE",
		"LICENSE-MIT"
	],
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "bun run typecheck"
	},
	"dependencies": {
		"@arachnejs/mcp": "workspace:*",
		"@arachnejs/router": "workspace:*",
		"cbor-x": "^1.6.6",
		"zod": "3.25.76",
		"@arachnejs/schema": "workspace:*"
	},
	"devDependencies": {
		"typescript": "^5.9.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
