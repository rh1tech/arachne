{
	"name": "@arachne/ui",
	"version": "0.0.1",
	"description": "UI primitives for Arachne (JSX + signals)",
	"license": "MIT OR Apache-2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./styles.css": "./src/styles.css",
		"./mcp": {
			"types": "./src/mcp.ts",
			"import": "./src/mcp.ts",
			"default": "./src/mcp.ts"
		}
	},
	"files": [
		"src",
		"README.md"
	],
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "bun run typecheck"
	},
	"dependencies": {
		"@arachne/jsx": "workspace:*",
		"@arachne/mcp": "workspace:*",
		"@arachne/render": "workspace:*",
		"@arachne/signals": "workspace:*",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@arachne/vite": "workspace:*",
		"happy-dom": "^18.0.1",
		"typescript": "^5.9.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
