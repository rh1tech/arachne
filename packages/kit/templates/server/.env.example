# Public URL (links in emails, CSRF origin checks)
BASE_URL=http://localhost:3000
# At least 32 random characters: `openssl rand -base64 32`
AUTH_SECRET=
DATABASE_PATH=data/app.db
# Leave SMTP_HOST empty in development: mails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Notebook <no-reply@example.com>
