{
	"name": "@arachne/kit",
	"version": "0.0.1",
	"description": "Arachne app kit: static, server and API apps, SSR, prerendering, dev server with hot reload, CLI",
	"license": "MIT OR Apache-2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./mcp": {
			"types": "./src/mcp.ts",
			"import": "./src/mcp.ts",
			"default": "./src/mcp.ts"
		}
	},
	"files": [
		"src",
		"bin",
		"README.md"
	],
	"scripts": {
		"test": "bun run scripts/test.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "bun run typecheck",
		"e2e": "bun test ./e2e/browser.e2e.ts && bun test ./e2e/server-template.e2e.ts"
	},
	"dependencies": {
		"@arachne/jsx": "workspace:*",
		"@arachne/mcp": "workspace:*",
		"@arachne/migrate": "workspace:*",
		"@arachne/db": "workspace:*",
		"@arachne/render": "workspace:*",
		"@arachne/router": "workspace:*",
		"@arachne/schema": "workspace:*",
		"@arachne/server": "workspace:*",
		"@arachne/signals": "workspace:*",
		"@arachne/vite": "workspace:*",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"happy-dom": "^18.0.1",
		"playwright": "^1.63.0",
		"typescript": "^5.9.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"arachne": "./bin/arachne.ts"
	}
}
