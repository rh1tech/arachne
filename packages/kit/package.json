{
	"name": "@arachnejs/kit",
	"version": "0.0.1",
	"description": "Arachne app kit: static, server and API apps, SSR, prerendering, dev server with hot reload, CLI",
	"license": "MIT OR Apache-2.0",
	"author": "Mikhail Matveev (https://rh1.tech)",
	"homepage": "https://arachne.rh1.tech/docs/packages/kit",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rh1tech/arachne.git",
		"directory": "packages/kit"
	},
	"bugs": {
		"url": "https://github.com/rh1tech/arachne/issues"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./mcp": {
			"types": "./src/mcp.ts",
			"import": "./src/mcp.ts",
			"default": "./src/mcp.ts"
		}
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/fixtures",
		"!src/test-utils",
		"bin",
		"README.md",
		"LICENSE-APACHE",
		"LICENSE-MIT",
		"templates",
		"!templates/*/node_modules",
		"!templates/*/data",
		"!templates/*/dist",
		"!templates/*/.arachne"
	],
	"scripts": {
		"test": "bun run scripts/test.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "bun run typecheck",
		"e2e": "bun test ./e2e/browser.e2e.ts && bun test ./e2e/server-template.e2e.ts"
	},
	"dependencies": {
		"@arachnejs/jsx": "workspace:*",
		"@arachnejs/mcp": "workspace:*",
		"@arachnejs/migrate": "workspace:*",
		"@arachnejs/db": "workspace:*",
		"@arachnejs/render": "workspace:*",
		"@arachnejs/router": "workspace:*",
		"@arachnejs/schema": "workspace:*",
		"@arachnejs/server": "workspace:*",
		"@arachnejs/signals": "workspace:*",
		"@arachnejs/vite": "workspace:*",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"happy-dom": "^18.0.1",
		"playwright": "^1.63.0",
		"typescript": "^5.9.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"arachne": "./bin/arachne.ts"
	}
}
