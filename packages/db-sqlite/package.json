{
	"name": "@arachne/db-sqlite",
	"version": "0.0.1",
	"description": "SQLite dialect for @arachne/db (bun:sqlite)",
	"license": "MIT OR Apache-2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./mcp": {
			"types": "./src/mcp.ts",
			"import": "./src/mcp.ts",
			"default": "./src/mcp.ts"
		}
	},
	"files": [
		"src",
		"README.md"
	],
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "bun run typecheck"
	},
	"dependencies": {
		"@arachne/db": "workspace:*",
		"@arachne/mcp": "workspace:*",
		"@arachne/schema": "workspace:*",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"typescript": "^5.9.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
