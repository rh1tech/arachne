{
	"name": "@arachne/mcp",
	"version": "0.0.1",
	"description": "MCP kernel for Arachne — compose per-package tool modules",
	"license": "MIT OR Apache-2.0",
	"type": "module",
	"bin": {
		"arachne-mcp": "./bin/arachne-mcp.ts"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"files": [
		"src",
		"bin",
		"README.md"
	],
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "bun run typecheck",
		"start": "bun run ./bin/arachne-mcp.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.30.1",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"typescript": "^5.9.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
