{
	"name": "@arachnejs/mcp",
	"version": "0.1.1",
	"description": "MCP kernel for Arachne — compose per-package tool modules",
	"license": "MIT OR Apache-2.0",
	"author": "Mikhail Matveev (https://rh1.tech)",
	"homepage": "https://arachne.rh1.tech/docs/packages/mcp",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rh1tech/arachne.git",
		"directory": "packages/mcp"
	},
	"bugs": {
		"url": "https://github.com/rh1tech/arachne/issues"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"type": "module",
	"bin": {
		"arachne-mcp": "./bin/arachne-mcp.ts"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/fixtures",
		"!src/test-utils",
		"bin",
		"README.md",
		"LICENSE-APACHE",
		"LICENSE-MIT"
	],
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "bun run typecheck",
		"start": "bun run ./bin/arachne-mcp.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.30.1",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"typescript": "^5.9.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
