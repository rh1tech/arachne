{
	"name": "@arachne/render",
	"version": "0.0.1",
	"description": "SSR/DOM render runtime and islands for Arachne",
	"license": "MIT OR Apache-2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./ssr": {
			"types": "./src/ssr.ts",
			"import": "./src/ssr.ts",
			"default": "./src/ssr.ts"
		},
		"./dom": {
			"types": "./src/dom.ts",
			"import": "./src/dom.ts",
			"default": "./src/dom.ts"
		},
		"./islands": {
			"types": "./src/islands.ts",
			"import": "./src/islands.ts",
			"default": "./src/islands.ts"
		},
		"./mcp": {
			"types": "./src/mcp.ts",
			"import": "./src/mcp.ts",
			"default": "./src/mcp.ts"
		}
	},
	"files": [
		"src",
		"README.md",
		"NOTICE"
	],
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "bun run typecheck"
	},
	"dependencies": {
		"@arachne/signals": "workspace:*",
		"@arachne/mcp": "workspace:*",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"happy-dom": "^18.0.1",
		"typescript": "^5.9.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
