{
	"name": "@arachnejs/render",
	"version": "0.0.1",
	"description": "SSR/DOM render runtime and islands for Arachne",
	"license": "MIT OR Apache-2.0",
	"author": "Mikhail Matveev (https://rh1.tech)",
	"homepage": "https://arachne.rh1.tech/docs/packages/render",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rh1tech/arachne.git",
		"directory": "packages/render"
	},
	"bugs": {
		"url": "https://github.com/rh1tech/arachne/issues"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./ssr": {
			"types": "./src/ssr.ts",
			"import": "./src/ssr.ts",
			"default": "./src/ssr.ts"
		},
		"./dom": {
			"types": "./src/dom.ts",
			"import": "./src/dom.ts",
			"default": "./src/dom.ts"
		},
		"./islands": {
			"types": "./src/islands.ts",
			"import": "./src/islands.ts",
			"default": "./src/islands.ts"
		},
		"./jsx-runtime": {
			"types": "./src/jsx-runtime.d.ts",
			"import": "./src/jsx-runtime.ts",
			"default": "./src/jsx-runtime.ts"
		},
		"./jsx-dev-runtime": {
			"types": "./src/jsx-runtime.d.ts",
			"import": "./src/jsx-runtime.ts",
			"default": "./src/jsx-runtime.ts"
		},
		"./mcp": {
			"types": "./src/mcp.ts",
			"import": "./src/mcp.ts",
			"default": "./src/mcp.ts"
		}
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/fixtures",
		"!src/test-utils",
		"README.md",
		"LICENSE-APACHE",
		"LICENSE-MIT",
		"NOTICE"
	],
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "bun run typecheck"
	},
	"dependencies": {
		"@arachnejs/signals": "workspace:*",
		"@arachnejs/mcp": "workspace:*",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@arachnejs/jsx": "workspace:*",
		"happy-dom": "^18.0.1",
		"typescript": "^5.9.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
