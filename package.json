{
	"name": "arachne",
	"private": true,
	"version": "0.0.0",
	"description": "Arachne — universal, modular, high-performance web framework",
	"license": "MIT OR Apache-2.0",
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*",
		"packages/kit/templates/*"
	],
	"scripts": {
		"prepare": "git config core.hooksPath .githooks",
		"build": "turbo run build",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"boundaries": "bun run scripts/check-boundaries.ts",
		"mcp": "bun run packages/mcp/bin/arachne-mcp.ts",
		"mcp:http": "bun run packages/mcp/bin/arachne-mcp.ts --http",
		"mcp:check": "bun run scripts/check-mcp.ts",
		"playground": "bun run apps/playground/server.ts",
		"ui:docs": "bun run scripts/gen-ui-docs.ts",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"ci": "bun run lint && bun run boundaries && bun run docs:check && bun run ui:docs --check && bun run ui:props && bun run mcp:check && bun run typecheck && bun run typecheck:tests && bun run test && bun run test:scripts",
		"ui:props": "bun run scripts/check-ui-props.ts",
		"docs:check": "bun run scripts/check-docs.ts",
		"test:scripts": "bun test scripts",
		"typecheck:tests": "tsc -p tsconfig.tests.json"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"@changesets/cli": "^2.29.7",
		"@types/bun": "^1.2.22",
		"turbo": "^2.5.6",
		"typescript": "^5.9.2"
	},
	"packageManager": "bun@1.3.13",
	"engines": {
		"bun": ">=1.3.0"
	}
}
